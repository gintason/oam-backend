import importlib
import logging

logger = logging.getLogger("integrations")

PROVIDER_MODULES = [
    "integrations.travel.travelpayouts.adapter",
    "integrations.delivery.ubereats.adapter",
    "integrations.remittance.wise.adapter",
    "integrations.remittance.lemfi.adapter",
