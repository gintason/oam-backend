def _safe_write(path: pathlib.Path, new: str, original: str, label: str) -> bool:
    path.write_text(new)
    try:
        ast.parse(new)
        print(f"  {label}: done")
        return True
    except SyntaxError as exc:
        path.write_text(original)
        print(f"  !! {label} would have broken ({exc}) — rolled back")
        return False


