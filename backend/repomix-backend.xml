            "service_images": {
                "have": count, "need": MIN_SERVICE_IMAGES, "max": MAX_SERVICE_IMAGES,
                "done": count >= MIN_SERVICE_IMAGES,
            },
            "work_video": {"done": bool(obj.work_video_id)},
            "id_document": {"done": bool(obj.id_document_id)},
        }


