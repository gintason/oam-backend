def _coords_for_city(city):
    if not city:
        return None
    c = " ".join(str(city).strip().lower().split())
    if c in CITY_COORDS:
        return CITY_COORDS[c]
    for name in sorted(CITY_COORDS, key=len, reverse=True):
        if name in c:
            return CITY_COORDS[name]
