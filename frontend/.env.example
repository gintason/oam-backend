# OAM frontend environment
# Copy to .env.local for local dev. Vite only exposes VITE_-prefixed vars.

# Where the Django backend is reachable. Include /api/v1.
VITE_API_URL=http://127.0.0.1:8080/api/v1

# Optional: WebSocket URL for live jobs chat. Leave unset to derive it from
# VITE_API_URL (https://api.x.com/api/v1 -> wss://api.x.com/ws/jobs/).
# VITE_WS_URL=wss://your-api.onrender.com/ws/jobs/
