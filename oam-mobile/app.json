{
  "expo": {
    "name": "O.A.M",
    "slug": "oam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oammobile",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "primaryColor": "#0B7327",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d51ee557-4078-4787-8c00-6a2ada5dcaa0",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oam.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "OAM uses your camera so you can photograph items to sell and submit verification documents.",
        "NSPhotoLibraryUsageDescription": "OAM needs access to your photos so you can upload listing images and verification documents.",
        "NSPhotoLibraryAddUsageDescription": "OAM saves receipt images and shared files to your photo library when you choose to.",
        "NSMicrophoneUsageDescription": "OAM uses your microphone when you record a short video of your work for artisan verification.",
        "NSLocationWhenInUseUsageDescription": "OAM uses your location to show artisans, listings and services near you.",
        "NSFaceIDUsageDescription": "OAM uses Face ID to protect your wallet and confirm sensitive account actions."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.oam.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/oam-adaptive-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "VIBRATE",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FBF6",
          "image": "./assets/images/oam-splash-icon.png",
          "imageWidth": 260
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OAM uses your location to show artisans, listings and services near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OAM needs access to your photos so you can upload listing images and verification documents.",
          "cameraPermission": "OAM uses your camera so you can photograph items to sell and submit verification documents.",
          "microphonePermission": "OAM uses your microphone when you record a short video of your work."
        }
      ],
      [
        "expo-gradle-properties",
        {
          "android.ndkVersion": "27.1.12297006"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.74521252008-5m06gkr34p4tcoimfrqjp62hq69d37v7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/oam-notification-icon.png",
          "color": "#0B7327"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d51ee557-4078-4787-8c00-6a2ada5dcaa0"
      }
    },
    "owner": "gintason"
  }
}
