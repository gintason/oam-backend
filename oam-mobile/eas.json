{
  "cli": {
    "version": ">= 12.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.oam-app.com/api/v1"
      },
      "node": "22.23.1"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.oam-app.com/api/v1"
      },
      "node": "22.23.1"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.oam-app.com/api/v1"
      },
      "node": "22.23.1"
    }
  },
  "submit": {
    "production": {}
  }
}