    key: str
    folder: str
    resource_type: str          # cloudinary: image | video | raw
    delivery_type: str          # upload (public) | authenticated (private)
    max_bytes: int
    allowed_formats: list[str]
    label: str
    hint: str = ""
    min_width: int = 0
    min_height: int = 0
    min_duration: float = 0     # seconds, video only
    max_duration: float = 0     # seconds, 0 = no limit


