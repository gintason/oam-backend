export const DEFAULT_COUNTRY = COUNTRIES[0]; // Nigeria

export function findByDial(value: string): Country | undefined {
  // Longest dial-code prefix match (so +234 beats +2). Used to split a stored
  // "+234803..." back into country + local number.
  const hits = COUNTRIES.filter((c) => value.startsWith(c.dial));
  return hits.sort((a, b) => b.dial.length - a.dial.length)[0];
}
