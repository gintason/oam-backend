    return data.revenue ?? [];
  },

  /** POST /billing/revenue/sweep/ — move revenue into your own wallet. */
  async sweep(input: { currency: string; amount: number | string }): Promise<{
    detail: string;
    currency: string;
    wallet_balance: string;
